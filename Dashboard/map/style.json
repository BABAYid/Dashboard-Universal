{
  "version": 8,
  "name": "Dashboard Dark",
  "sources": {
    "osm": {
      "type": "vector",
      "tiles": [
        "/tiles/{z}/{x}/{y}"
      ],
      "minzoom": 8,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": {
        "background-color": "#070D13"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#0E2019",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#0B1820",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "paint": {
        "fill-color": "#10251B"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#0E1A25",
        "fill-opacity": 1
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0D2230"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#0D2230",
        "line-width": 2
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#7E8F9C",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.8,
          13,
          3.5
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#BCEAF1",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.2,
          13,
          5
        ]
      }
    },
    {
      "id": "street-names",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Lato"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          10,
          16,
          13
        ],
        "text-padding": 2,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#A9BAC7",
        "text-halo-color": "#070D13",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#24343F",
        "line-width": 1
      }
    }
  ],
  "glyphs": "/fonts/{fontstack}/{range}.pbf"
}